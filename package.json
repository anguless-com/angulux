{
    "name": "angulux-workspace",
    "version": "22.0.0-rc.0",
    "private": true,
    "license": "MIT",
    "author": "Anguless",
    "homepage": "https://angulux.anguless.com/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anguless-com/angulux.git"
    },
    "bugs": {
        "url": "https://github.com/anguless-com/angulux/issues"
    },
    "packageManager": "pnpm@9.6.0",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "check:catalog": "node tools/check-catalog.mjs",
        "check:license": "node tools/check-prime-license.mjs",
        "check:scope": "node tools/scope/gen-closure.mjs --check",
        "check:names": "node tools/codemod/scan-prime-names.mjs",
        "check:risk-coverage": "node tools/scope/check-risk-coverage.mjs",
        "check:language": "node tools/check-language.mjs",
        "check:public-tree": "node tools/check-public-tree.mjs",
        "check:publishable": "node tools/check-publishable.mjs",
        "check:dts": "node tools/check-dts.mjs",
        "check:scope-names": "node tools/codemod/scan-anguless-scope.mjs",
        "check": "npm run check:catalog && npm run check:scope && npm run check:license && npm run check:names && npm run check:risk-coverage && npm run check:language && npm run check:public-tree && npm run check:scope-names && npm run check:tsup && npm run check:action-inputs && npm run check:facet-single-route && npm run check:corpus && npm run check:demo-code && npm run check:gate-count",
        "build:lib": "pnpm --filter @anguless/angulux run build",
        "test:lib": "pnpm --filter @anguless/angulux run test:unit",
        "test:tools": "node --test \"packages/angulux-license-guard/test/**/*.test.mjs\" \"packages/angulux-migrate/test/**/*.test.mjs\" \"tools/corpus/test/**/*.test.mjs\" \"tools/test/**/*.test.mjs\" \"packages/angulux-mcp/test/**/*.test.mjs\"",
        "check:tsup": "node tools/check-tsup-usage.mjs",
        "check:gate-count": "node tools/check-gate-count.mjs",
        "check:corpus": "node tools/check-corpus.mjs",
        "check:demo-code": "node tools/check-demo-code.mjs",
        "check:action-inputs": "node tools/check-action-inputs.mjs",
        "check:facet-single-route": "node tools/check-facet-single-route.mjs"
    },
    "pnpm": {
        "overrides": {
            "postcss": "8.5.23",
            "@modelcontextprotocol/sdk": "^1.30.0",
            "esbuild": "^0.28.1",
            "@hono/node-server": "^2.0.5"
        }
    },
    "devDependencies": {
        "@angular/animations": "catalog:angular22",
        "@angular/build": "catalog:angular22",
        "@angular/cli": "catalog:angular22",
        "@angular/common": "catalog:angular22",
        "@angular/compiler": "catalog:angular22",
        "@angular/compiler-cli": "catalog:angular22",
        "@angular/core": "catalog:angular22",
        "@angular/forms": "catalog:angular22",
        "@angular/platform-browser": "catalog:angular22",
        "@angular/router": "catalog:angular22",
        "@playwright/test": "1.62.1",
        "@types/jasmine": "6.0.0",
        "@types/node": "26.1.2",
        "chart.js": "catalog:",
        "cross-env": "^10.1.0",
        "fs-extra": "^11.3.2",
        "glob": "^13.0.6",
        "jasmine-core": "6.3.0",
        "ng-packagr": "catalog:angular22",
        "rxjs": "catalog:angular22",
        "tslib": "catalog:angular22",
        "tsup": "^8.5.0",
        "typescript": "catalog:angular22",
        "zone.js": "catalog:angular22"
    }
}
