{
    "name": "angulux-workspace",
    "version": "22.0.0-rc.0",
    "private": true,
    "license": "MIT",
    "author": "Anguless",
    "homepage": "https://angulux.anguless.com/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/anguless-com/angulux.git"
    },
    "bugs": {
        "url": "https://github.com/anguless-com/angulux/issues"
    },
    "packageManager": "pnpm@9.6.0",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "check:catalog": "node tools/check-catalog.mjs",
        "check:license": "node tools/check-prime-license.mjs",
        "check:scope": "node tools/scope/gen-closure.mjs --check",
        "check:names": "node tools/codemod/scan-prime-names.mjs",
        "check:risk-coverage": "node tools/scope/check-risk-coverage.mjs",
        "check:language": "node tools/check-language.mjs",
        "check:public-tree": "node tools/check-public-tree.mjs",
        "check:publishable": "node tools/check-publishable.mjs",
        "check:dts": "node tools/check-dts.mjs",
        "check:signal-forms": "node tools/check-signal-forms.mjs",
        "check:scope-names": "node tools/codemod/scan-anguless-scope.mjs",
        "check": "npm run check:catalog && npm run check:scope && npm run check:license && npm run check:names && npm run check:risk-coverage && npm run check:language && npm run check:public-tree && npm run check:scope-names && npm run check:tsup && npm run check:action-inputs && npm run check:release-plugins && npm run check:facet-single-route && npm run check:corpus && npm run check:api-surface && npm run check:demo-code && npm run check:lint && npm run check:spec-waits && npm run check:peer-licence && npm run check:install-scripts && npm run check:module-counts && npm run check:gate-count",
        "build:lib": "pnpm --filter @anguless/angulux run build",
        "test:lib": "pnpm --filter @anguless/angulux run test:unit",
        "test:tools": "node --test \"packages/angulux-license-guard/test/**/*.test.mjs\" \"packages/angulux-migrate/test/**/*.test.mjs\" \"tools/corpus/test/**/*.test.mjs\" \"tools/test/**/*.test.mjs\" \"packages/angulux-mcp/test/**/*.test.mjs\"",
        "check:tsup": "node tools/check-tsup-usage.mjs",
        "check:gate-count": "node tools/check-gate-count.mjs",
        "check:install-scripts": "node tools/check-install-scripts.mjs",
        "check:module-counts": "node tools/check-module-counts.mjs",
        "check:corpus": "node tools/check-corpus.mjs",
        "check:api-surface": "node tools/check-api-surface.mjs",
        "check:lint": "node tools/check-lint.mjs",
        "check:spec-waits": "node tools/check-spec-waits.mjs",
        "check:size": "node tools/measure-size.mjs --check",
        "measure:size": "node tools/measure-size.mjs",
        "measure:load": "node tools/measure-load.mjs",
        "measure:speed": "node tools/measure-speed.mjs",
        "check:demo-code": "node tools/check-demo-code.mjs",
        "check:peer-licence": "node tools/check-peer-licence.mjs",
        "check:action-inputs": "node tools/check-action-inputs.mjs",
        "check:facet-single-route": "node tools/check-facet-single-route.mjs",
        "check:release-plugins": "node tools/check-release-plugins.mjs",
        "watch:upstream": "node tools/upstream/watch-changelog.mjs"
    },
    "pnpm": {
        "onlyBuiltDependencies": ["@parcel/watcher", "esbuild", "lmdb", "msgpackr-extract"],
        "overrides": {
            "postcss": "8.5.23",
            "@hono/node-server": "2.1.8",
            "hono": "4.13.18",
            "fast-uri": "3.1.9",
            "vite": "8.3.5",
            "follow-redirects": "1.16.2",
            "body-parser@<2": "1.20.9",
            "body-parser@>=2": "2.4.0",
            "zod": "4.6.7",
            "qs": "6.17.1",
            "ip-address": "10.7.5"
        },
        "auditConfig": {
            "ignoreCves": ["CVE-2026-93687"]
        }
    },
    "devDependencies": {
        "@angular/animations": "catalog:angular22",
        "@angular/build": "catalog:angular22",
        "@angular/cli": "catalog:angular22",
        "@angular/common": "catalog:angular22",
        "@angular/compiler": "catalog:angular22",
        "@angular/compiler-cli": "catalog:angular22",
        "@angular/core": "catalog:angular22",
        "@angular/forms": "catalog:angular22",
        "@angular/platform-browser": "catalog:angular22",
        "@angular/router": "catalog:angular22",
        "@axe-core/playwright": "catalog:",
        "@playwright/test": "1.65.1",
        "@types/jasmine": "7.0.0",
        "@types/node": "26.6.6",
        "angular-eslint": "catalog:",
        "chart.js": "catalog:",
        "cross-env": "10.1.0",
        "esbuild": "0.28.2",
        "eslint": "catalog:",
        "fs-extra": "11.4.1",
        "glob": "14.0.6",
        "jasmine-core": "7.0.2",
        "ng-packagr": "catalog:angular22",
        "rxjs": "catalog:angular22",
        "tslib": "catalog:angular22",
        "tsup": "9.0.0",
        "typescript": "catalog:angular22",
        "typescript-eslint": "catalog:",
        "zone.js": "catalog:angular22"
    }
}
